# Copy to .env.local and fill in from your Supabase project's API settings.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# RevenueCat public SDK keys (Project settings > API keys). Safe to ship in the app.
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=

# One link to get the app (TestFlight/Play testing during the pilot; a page
# that picks the right store after launch). Goes in every invite message.
EXPO_PUBLIC_DOWNLOAD_URL=

# Terms of Use and Privacy Policy pages (required by Apple for subscriptions).
EXPO_PUBLIC_TERMS_URL=https://condorllc.org/assets/dailypulse/terms.html
EXPO_PUBLIC_PRIVACY_URL=https://condorllc.org/assets/dailypulse/privacy.html
