{
  "expo": {
    "name": "DailyPulse",
    "slug": "dailypulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dailypulse",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.condorllc.dailypulse",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.condorllc.dailypulse",
      "adaptiveIcon": {
        "backgroundColor": "#1F7A96",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EEF3F6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-sqlite",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#1F5E7A",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "DailyPulse uses the camera so you can send a photo or selfie when you check in.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "22e2394d-799e-4190-82c0-2cc99f9cf13b"
      }
    },
    "owner": "norjam02s-team"
  }
}
